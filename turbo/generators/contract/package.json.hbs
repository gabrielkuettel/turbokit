{
  "name": "@turbokit/{{kebabCase contractName}}",
  "version": "0.1.0",
  "description": "{{description}}",
  "type": "module",
  "private": true,
  "exports": {
    "./arc56": "./artifacts/{{pascalCase contractName}}.arc56.json",
    "./approval-program": "./artifacts/{{pascalCase contractName}}.approval.teal",
    "./clear-program": "./artifacts/{{pascalCase contractName}}.clear.teal",
    "./minimal-client": "./artifacts/{{pascalCase contractName}}.minimal-client.ts",
    "./": "./artifacts/{{pascalCase contractName}}.client.ts"
  },
  "scripts": {
    "build": "npm run build:contract && npm run build:client && npm run build:minimal-client",
    "build:contract": "puya-ts ./src --output-source-map --out-dir ../artifacts",
    "build:client": "algokit-client-generator generate -a ./artifacts/{{pascalCase contractName}}.arc56.json -o ./artifacts/{{pascalCase contractName}}.client.ts",
    "build:minimal-client": "algokit-client-generator generate -a ./artifacts/{{pascalCase contractName}}.arc56.json -o ./artifacts/{{pascalCase contractName}}.minimal-client.ts -m minimal",
    "deploy": "tsx --no-check ./src/deploy.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "better-npm-audit audit",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.0"
  },
  "dependencies": {
    "@algorandfoundation/algorand-typescript": "^1.0.1"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^6.0.0",
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "@algorandfoundation/algokit-utils-debug": "^1.0.4",
    "@algorandfoundation/puya-ts": "^1.0.1",
    "@turbokit/eslint-config": "*",
    "@turbokit/prettier-config": "*",
    "@turbokit/typescript-config": "*",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node22": "^22.0.0",
    "algosdk": "^3.0.0",
    "better-npm-audit": "^3.11.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.19.1",
    "prettier": "^3.4.2",
    "ts-node-dev": "^2.0.0",
    "@algorandfoundation/algorand-typescript-testing": "^1.0.1",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.3"
  }
}
